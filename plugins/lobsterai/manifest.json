{
  "id": "lobsterai",
  "name": "LobsterAI（有道）",
  "version": "0.1.0",
  "api_level": 2,
  "description": "把宿主的 OpenAI 兼容请求转发到 LobsterAI（有道，https://lobsterai-server.youdao.com 的 /api/proxy/v1/chat/completions）。上游说 OpenAI chat 协议且只支持流式（stream:false 会 500），本插件强制 stream 并在客户端要非流式时聚合 SSE。凭据由插件自持（DATA_DIR\\accounts.dat，DPAPI 保护）。登录是门户 OAuth：插件给出真实登录 URL，用户在浏览器完成后把 code POST 给 /admin/exchange，无需任何硬编码密钥。",
  "author": "",
  "homepage": "https://lobsterai.youdao.com",
  "os": [
    "windows"
  ],
  "capabilities": [
    "upstream",
    "accounts",
    "refresh",
    "login_oauth",
    "egress",
    "identity_request"
  ],
  "permissions": {
    "read_paths": [],
    "launch_apps": [],
    "network_domains": [
      "lobsterai-server.youdao.com",
      "lobsterai.youdao.com",
      "api-overmind.youdao.com"
    ],
    "use_proxy": true,
    "os_identity": false,
    "require_admin": false
  },
  "egress": {
    "strict": false
  },
