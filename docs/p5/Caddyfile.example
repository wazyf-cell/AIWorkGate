# AIWorkGate + Caddy（P5-6 / P14）
# 放到 /etc/caddy/Caddyfile，替换 ai.example.com 与邮箱；`caddy validate` 后 reload。

{
	email admin@example.com
}

ai.example.com {
	encode zstd gzip

	# 公网只放行推理 API、Key 自助页和健康检查。
	# 管理页 / 与 /api/* 不对外发布（走 SSH 隧道），这是 P7 的安全前置。
	@public path /v1/* /me /me/* /healthz /health
	handle @public {
		reverse_proxy 127.0.0.1:7865
	}
	handle {
		respond "not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /var/log/caddy/aiworkgate.log
		format json
	}
}
