{
  "id": "loomy",
  "name": "Loomy（讯飞）",
  "version": "0.1.0",
  "api_level": 2,
  "description": "把宿主的 OpenAI 兼容请求转发到 Loomy（讯飞，https://loomyad.xunfei.cn/api/v1）。上游本身说 OpenAI chat 协议且只支持流式，本插件强制 stream 并在客户端要非流式时聚合 SSE。凭据由插件自持（DATA_DIR\\accounts.dat，DPAPI 保护），不经宿主环境变量传入。登录：微信扫码（login_oauth）——插件取微信二维码并长轮询扫码状态，扫码确认后用讯飞账号体系做 HMAC-SHA1 签名换票，成功后 session 自动落库；签名用的 accessKeyId/accessKeySecret 只从环境变量 LOOMY_XFYUN_ACCESS_KEY_ID / LOOMY_XFYUN_ACCESS_KEY_SECRET 读取，插件不内置任何凭据，未配置时发起登录会明确告知要设这两个变量。",
  "author": "",
  "homepage": "https://loomy.xunfei.cn",
  "os": [
    "windows"
  ],
  "capabilities": [
    "upstream",
    "accounts",
    "login_oauth"
  ],
  "permissions": {
    "read_paths": [],
    "launch_apps": [],
    "network_domains": [
      "loomyad.xunfei.cn",
      "account.xfinfr.com",
      "open.weixin.qq.com",
      "long.open.weixin.qq.com"
    ],
    "use_proxy": false,
    "os_identity": false,
    "require_admin": false
  },
  "egress": {
    "strict": false
  },
  "models": [
